# RuuBusiness Backend Environment Configuration

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Database Connection (Neon PostgreSQL Pool URL)
DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT Secret Key for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# CORS Allowed Origins (Comma separated URLs for Production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Groq AI Service API Key (Optional / AI Assistant)
GROQ_API_KEY=gsk_your_groq_api_key_here
